timeout /t 3 >nul

%PYTHON_CMD% تشغيل_النافذة_المحسنة.py

if errorlevel 1 (
    echo.
    echo ❌ حدث خطأ في تشغيل النافذة المحسنة
    echo.
    echo 💡 جاري المحاولة مع النوافذ البديلة...
    
