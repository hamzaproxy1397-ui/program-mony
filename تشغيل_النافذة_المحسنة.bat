        echo 🔄 محاولة تشغيل النافذة المتقدمة...
        %PYTHON_CMD% تشغيل_نافذة_الموظفين_المتقدمة.py
        if not errorlevel 1 goto :success
    )
    
    if exist "تشغيل_نافذة_الموظفين.py" (
        echo 🔄 محاولة تشغيل النافذة الأساسية...
        %PYTHON_CMD% تشغيل_نافذة_الموظفين.py
        if not errorlevel 1 goto :success
    )
    
    if exist "تشغيل_النافذة_الأصلية.py" (
        echo 🔄 محاولة تشغيل النافذة الرئيسية...
        %PYTHON_CMD% تشغيل_النافذة_الأصلية.py
        if not errorlevel 1 goto :success
    )
    
    echo ❌ لم يتم العثور على نوافذ بديلة أو فشل تشغيلها
    goto :troubleshoot
)

:success
echo.
echo ✅ تم إغلاق نظام إدارة الموظفين المحسن بنجاح
