@echo off
chcp 65001 >nul
title 🏢 نظام إدارة الموظفين المتقدم - برنامج ست الكل للمحاسبة
color 0A

echo.
echo ╔══════════════════════════════════════════════════════════════╗
echo ║                🏢 نظام إدارة الموظفين المتقدم               ║
echo ║              📊 برنامج ست الكل للمحاسبة                   ║
echo ║                                                              ║
echo ║                   👥 إدارة شاملة للموظفين                  ║
echo ║                   💼 واجهة احترافية ومتقدمة                ║
echo ╚══════════════════════════════════════════════════════════════╝
echo.

cd /d "%~dp0"

echo 🔍 فحص Python...

REM فحص Python
python --version >nul 2>&1
if not errorlevel 1 (
    echo ✅ Python متوفر
    set PYTHON_CMD=python
    goto :run_employees
)

py --version >nul 2>&1
if not errorlevel 1 (
    echo ✅ Python متوفر عبر py launcher
    set PYTHON_CMD=py
    goto :run_employees
)

echo ❌ Python غير مثبت!
echo.
echo 📥 يرجى تثبيت Python أولاً من: https://www.python.org/downloads/
goto :end

:run_employees
echo.
echo 🏢 تشغيل نظام إدارة الموظفين المتقدم...
echo.
echo 📋 الميزات المتاحة:
echo    ✅ جدول عرض الموظفين مع البحث والفلترة
echo    ✅ نماذج إضافة وتعديل الموظفين
echo    ✅ إدارة الرواتب والمكافآت
echo    ✅ تقارير شاملة للموظفين
echo    ✅ تتبع الحضور والغياب
echo    ✅ واجهة عربية احترافية
echo    ✅ ربط بقاعدة البيانات
echo.
echo 🎯 نافذة شاملة ومتقدمة لإدارة جميع بيانات الموظفين
echo.

timeout /t 3 >nul

%PYTHON_CMD% تشغيل_نافذة_الموظفين.py

if errorlevel 1 (
    echo.
    echo ❌ حدث خطأ في تشغيل نافذة الموظفين
    echo.
    echo 💡 جاري المحاولة مع النافذة الرئيسية...
    
    if exist "تشغيل_النافذة_الأصلية.py" (
        echo 🔄 محاولة تشغيل النافذة الرئيسية...
        %PYTHON_CMD% تشغيل_النافذة_الأصلية.py
    ) else if exist "main.py" (
        echo 🔄 محاولة تشغيل main.py...
        %PYTHON_CMD% main.py
    ) else (
        echo ❌ لم يتم العثور على ملفات بديلة
    )
)

echo.
echo ✅ تم إغلاق نظام إدارة الموظفين

:end
echo.
echo ╔══════════════════════════════════════════════════════════════╗
echo ║                  🏢 نظام إدارة الموظفين المتقدم            ║
echo ╠══════════════════════════════════════════════════════════════╣
echo ║  📊 جدول الموظفين: عرض وبحث وفلترة متقدمة                ║
echo ║  📝 نماذج البيانات: إضافة وتعديل احترافية                 ║
echo ║  💰 إدارة الرواتب: حساب ومتابعة الرواتب                  ║
echo ║  📈 التقارير: تقارير شاملة ومفصلة                         ║
echo ║  📅 الحضور والغياب: تتبع دقيق للحضور                     ║
echo ║  🎨 الواجهة: عربية احترافية ومتجاوبة                     ║
echo ║  💾 قاعدة البيانات: حفظ آمن ومنظم                        ║
echo ║  🔧 التكامل: ربط كامل مع النظام الرئيسي                  ║
echo ╚══════════════════════════════════════════════════════════════╝
echo.
echo اضغط أي مفتاح للخروج...
pause >nul
