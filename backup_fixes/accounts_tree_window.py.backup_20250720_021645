        # جعل النافذة في المقدمة
        self.window.transient(self.parent)
        self.window.grab_set()
        
        # إنشاء المحتوى
        self.create_header()
        self.create_main_content()
        self.create_buttons()
        
        # تحميل البيانات
        self.load_accounts_tree()
    
