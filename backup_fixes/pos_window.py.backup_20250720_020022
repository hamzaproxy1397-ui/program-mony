class POSWindow:
    def __init__(self, parent):
        self.parent = parent
        self.window = None
        self.cart_items = []  # سلة المشتريات
        self.total_amount = 0.0  # إجمالي الفاتورة
        self.selected_customer = None  # العميل المحدد
        self.current_quantity = 1  # الكمية الحالية

