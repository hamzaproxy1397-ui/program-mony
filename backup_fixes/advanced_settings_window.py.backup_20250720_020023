    def change_number_value(self, var, change, min_val, max_val):
        """تغيير قيمة الحقل الرقمي"""
        try:
            current = var.get()
            new_value = current + change
            new_value = max(min_val, min(max_val, new_value))
            var.set(new_value)
        except:
            var.set(min_val)

