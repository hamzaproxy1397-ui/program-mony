            text_color=MODERN_COLORS['text_primary']
        )
        chart_title.pack(pady=(0, 15))

        if not MATPLOTLIB_AVAILABLE:
            # عرض رسالة بديلة إذا لم تكن matplotlib متوفرة
            no_chart_label = ctk.CTkLabel(
                chart_frame,
