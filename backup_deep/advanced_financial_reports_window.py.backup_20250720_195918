                    font=(FONTS['arabic'], 12, "bold"),
                    text_color="white"
                )
                total_label.pack(pady=5)

                total += category_total
            else:
                # عنصر مباشر
                item_frame = ctk.CTkFrame(section_content, fg_color=MODERN_COLORS['card'])
                item_frame.pack(fill="x", pady=2)

