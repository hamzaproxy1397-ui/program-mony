            grand_total_frame = ctk.CTkFrame(parent, fg_color=MODERN_COLORS['text_primary'], height=40)
            grand_total_frame.pack(fill="x", padx=10, pady=(0, 10))
            grand_total_frame.pack_propagate(False)

